# Application
APP_ENV=development
APP_DEBUG=False
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
APP_COOKIE_SECURE=False
APP_COOKIE_SAMESITE=lax
APP_AUTH_COOKIE_NAME=authorization

# JWT auth
JWT_SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ISSUER=fastapi-backend-template
JWT_AUDIENCE=fastapi-backend-template-api

# Password hashing
PASSWORD_PEPPER=dev-only-change-me-fedcba9876543210fedcba9876543210
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_MEMORY_COST=65536
PASSWORD_ARGON2_PARALLELISM=4

# Rate limiting (IP + username)
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_ATTEMPTS=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
